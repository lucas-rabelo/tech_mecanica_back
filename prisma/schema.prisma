generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique @db.VarChar(255)
  name         String     @db.VarChar(255)
  birthDate    DateTime   @db.Date
  phone        String     @db.VarChar(255)
  password     String     @db.Text
  document     String     @unique
  permissionId Int        @unique
  permission   Permission @relation(fields: [permissionId], references: [id])
  tenantId     Int?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  userStatusId Int
  userStatus   UserStatus @relation(fields: [userStatusId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?

  @@map("users")
}

model UserStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(255)
  users User[]

  @@map("user_status")
}

model Permission {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  user             User[]
  permissionModule PermissionModule[]
  permissionPage   PermissionPage[]

  @@map("permissions")
}

model PermissionModule {
  id           Int        @id @default(autoincrement())
  permissionId Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  moduleId     Int
  module       Module     @relation(fields: [moduleId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?

  @@map("permission_modules")
}

model Module {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(255)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime?
  deletedAt         DateTime?
  pages             Page[]
  permissionModules PermissionModule[]

  @@map("modules")
}

model Page {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.VarChar(255)
  moduleId       Int
  module         Module           @relation(fields: [moduleId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?
  permissionPage PermissionPage[]

  @@map("pages")
}

model PermissionPage {
  id           Int        @id @default(autoincrement())
  permissionId Int
  pageId       Int
  permission   Permission @relation(fields: [permissionId], references: [id])
  page         Page       @relation(fields: [pageId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  deletedAt    DateTime?

  @@map("permission_pages")
}

model Tenant {
  id             Int          @id @default(autoincrement())
  name           String       @db.VarChar(255)
  tenantStatusId Int
  subdomain      String       @unique @default("test") @db.VarChar(255)
  tenantStatus   TenantStatus @relation(fields: [tenantStatusId], references: [id])
  users          User[]
  branches       Branch[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?

  @@map("tenants")
}

model TenantStatus {
  id      Int      @id @default(autoincrement())
  name    String   @unique @db.VarChar(255)
  tenants Tenant[]

  @@map("tenant_status")
}

model Branch {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(255)
  address        String          @db.VarChar(255)
  number         String          @db.VarChar(255)
  neighborhood   String          @db.VarChar(255)
  city           String          @db.VarChar(255)
  uf             String          @db.VarChar(255)
  zipCode        String          @db.VarChar(255)
  isMain         Boolean         @default(false) @db.Boolean
  tenantId       Int
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?
  branchServices BranchService[]
  branchContact  BranchContact[]

  @@map("branches")
}

model BranchContact {
  id         Int       @id @default(autoincrement())
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id])
  phone      String    @db.VarChar(14)
  email      String    @db.VarChar(255)
  isWhatsapp Boolean   @default(false) @db.Boolean
  createdAt  DateTime  @default(now())
  updatedAt  DateTime?
  deletedAt  DateTime?

  @@map("branch_contacts")
}

model BranchService {
  id        Int       @id @default(autoincrement())
  branchId  Int
  branch    Branch    @relation(fields: [branchId], references: [id])
  serviceId Int
  service   Service   @relation(fields: [serviceId], references: [id])
  price     Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  @@map("branch_services")
}

model Service {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(255)
  description    String?         @db.VarChar(255)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime?
  deletedAt      DateTime?
  branchServices BranchService[]

  @@map("services")
}
